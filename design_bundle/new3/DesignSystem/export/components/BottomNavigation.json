{
  "kind": "component",
  "name": "BottomNavigation",
  "version": "2026-09-18",
  "description": "Persistent bottom navigation bar between core app sections, with active-item accent color and optional badges/labels.",
  "size": {
    "width": "fill",
    "height": "--bottomnav-height-labeled"
  },
  "surface": {
    "background": "--bottomnav-bg",
    "radius": "--radius-full",
    "border": null,
    "padding": null
  },
  "tree": {
    "slot": "root",
    "type": "row",
    "spacing": [],
    "padding": null,
    "align": "stretch",
    "justify": "start",
    "scroll": "none",
    "size": {
      "width": "fill",
      "height": "--bottomnav-height-labeled"
    },
    "children": [
      {
        "slot": "item",
        "type": "column",
        "spacing": [
          "--space-xxs"
        ],
        "padding": {
          "y": "--space-xs"
        },
        "align": "center",
        "justify": "center",
        "scroll": "none",
        "size": {
          "width": "fill"
        },
        "children": [
          {
            "slot": "item.icon",
            "type": "icon",
            "name": "{it.icon}",
            "weight": "regular",
            "size": "--icon-md",
            "color": "--bottomnav-icon",
            "overlay": [
              {
                "slot": "item.badge",
                "type": "box",
                "size": [
                  16,
                  16
                ],
                "radius": "--radius-full",
                "background": "--badge-bg",
                "border": null,
                "position": {
                  "top": -4,
                  "right": -8
                },
                "child": {
                  "slot": "item.badge.text",
                  "type": "text",
                  "content": "{it.badge}",
                  "style": "--text-body-xs",
                  "color": "--badge-text",
                  "lines": 1,
                  "overflow": "clip",
                  "align": "center",
                  "transform": "none",
                  "size": {
                    "width": "hug"
                  }
                }
              }
            ]
          },
          {
            "slot": "item.label",
            "type": "text",
            "content": "{it.label}",
            "style": "--text-body-xs",
            "color": "--bottomnav-icon",
            "lines": 1,
            "overflow": "clip",
            "align": "center",
            "transform": "none",
            "size": {
              "width": "hug"
            }
          }
        ],
        "gap": 0
      }
    ]
  },
  "variants": {
    "active": {
      "prop": "activeKey",
      "cases": {
        "match": {
          "item.icon": {
            "weight": "fill",
            "color": "--bottomnav-icon-active"
          },
          "item.label": {
            "color": "--bottomnav-icon-active"
          }
        }
      }
    },
    "badge": {
      "prop": "it.badge",
      "cases": {
        "null": {
          "item.badge": {
            "visible": false
          }
        }
      }
    },
    "showLabels": {
      "prop": "showLabels",
      "cases": {
        "false": {
          "item.label": {
            "visible": false
          },
          "root": {
            "size": {
              "height": "--bottomnav-height"
            }
          }
        }
      }
    }
  },
  "uses": [],
  "notes": "root height uses --bottomnav-height-labeled directly (48px) since the bar's own height IS that named token by design, treated as an exception to the own-dimension-is-a-number rule (same exception as IconButton's hit target); showLabels:false swaps to --bottomnav-height (also 48px)."
}