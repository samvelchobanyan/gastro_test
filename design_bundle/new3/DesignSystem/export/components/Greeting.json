{
  "kind": "component",
  "name": "Greeting",
  "version": "2026-09-18",
  "description": "App home header row: brand mark, a two-line greeting ('Greetings' overline + name), and a notification bell with an unread dot.",
  "size": {
    "width": "fill",
    "height": "hug"
  },
  "surface": {
    "background": "--color-bg-surface",
    "radius": null,
    "border": null,
    "padding": {
      "all": "--space-base"
    }
  },
  "tree": {
    "slot": "root",
    "type": "row",
    "spacing": [
      "--space-md",
      "--space-md"
    ],
    "padding": null,
    "align": "center",
    "justify": "start",
    "scroll": "none",
    "size": {
      "width": "fill"
    },
    "children": [
      {
        "slot": "logo",
        "type": "image",
        "source": "{logoUrl}",
        "size": [
          44,
          44
        ],
        "fit": "cover",
        "radius": "--radius-md",
        "fallback": {
          "slot": "logo.fallback",
          "type": "box",
          "background": "--color-brand-primary"
        }
      },
      {
        "slot": "text",
        "type": "column",
        "spacing": [
          "--space-xxs"
        ],
        "padding": null,
        "align": "start",
        "justify": "center",
        "scroll": "none",
        "size": {
          "width": "fill"
        },
        "children": [
          {
            "slot": "overline",
            "type": "text",
            "content": "{greeting}",
            "style": "--text-caption",
            "color": "--color-text-tertiary",
            "lines": 1,
            "overflow": "clip",
            "align": "start",
            "transform": "none",
            "size": {
              "width": "fill"
            }
          },
          {
            "slot": "name",
            "type": "text",
            "content": "{name}",
            "style": "--text-h3",
            "color": "--color-text-primary",
            "lines": 1,
            "overflow": "ellipsis",
            "align": "start",
            "transform": "none",
            "size": {
              "width": "fill"
            }
          }
        ]
      },
      {
        "slot": "bell",
        "type": "box",
        "size": [
          44,
          44
        ],
        "background": null,
        "radius": "--radius-full",
        "border": null,
        "padding": null,
        "child": {
          "slot": "bell.icon",
          "type": "icon",
          "name": "bell",
          "weight": "regular",
          "size": "--icon-md",
          "color": "--color-text-primary"
        },
        "overlay": [
          {
            "slot": "bell.dot",
            "type": "box",
            "size": [
              9,
              9
            ],
            "radius": "--radius-full",
            "background": "--color-brand-primary",
            "border": {
              "width": 2,
              "color": "--color-bg-surface"
            },
            "position": {
              "top": 9,
              "right": 10
            }
          }
        ]
      }
    ]
  },
  "variants": {
    "hasNotifications": {
      "prop": "hasNotifications",
      "cases": {
        "false": {
          "bell.dot": {
            "visible": false
          }
        }
      }
    },
    "logo": {
      "prop": "logoUrl",
      "cases": {
        "null": {
          "logo.fallback": {
            "visible": true,
            "child": {
              "slot": "logo.fallback.icon",
              "type": "icon",
              "name": "fork-knife",
              "weight": "fill",
              "size": "--icon-md",
              "color": "--color-text-on-brand"
            }
          }
        }
      }
    }
  },
  "uses": [],
  "notes": ""
}