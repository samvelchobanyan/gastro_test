{
  "kind": "component",
  "name": "Button",
  "version": "2026-09-12",
  "description": "Primary, secondary, tertiary and destructive action button with optional leading/trailing icon and loading state.",
  "size": {
    "width": "hug",
    "height": 48
  },
  "surface": null,
  "tree": {
    "slot": "root",
    "type": "row",
    "spacing": [
      "--space-sm",
      "--space-sm"
    ],
    "padding": {
      "x": 20,
      "y": null
    },
    "align": "center",
    "justify": "center",
    "scroll": "none",
    "size": {
      "width": "hug",
      "height": 48
    },
    "children": [
      {
        "slot": "iconLeft",
        "type": "icon",
        "name": "{iconLeft}",
        "weight": "regular",
        "size": "--icon-md",
        "color": "--button-primary-text"
      },
      {
        "slot": "label",
        "type": "text",
        "content": "{children}",
        "style": "--text-body",
        "color": "--button-primary-text",
        "lines": 1,
        "overflow": "clip",
        "align": "center",
        "transform": "none",
        "size": {
          "width": "hug"
        }
      },
      {
        "slot": "iconRight",
        "type": "icon",
        "name": "{iconRight}",
        "weight": "regular",
        "size": "--icon-md",
        "color": "--button-primary-text"
      }
    ]
  },
  "variants": {
    "variant": {
      "prop": "variant",
      "cases": {
        "secondary": {
          "root": {
            "background": "--button-secondary-bg",
            "border": {
              "width": 1,
              "color": "--button-secondary-border"
            }
          },
          "label": {
            "color": "--button-secondary-text"
          }
        },
        "tertiary": {
          "root": {
            "background": "transparent"
          },
          "label": {
            "color": "--button-tertiary-text"
          }
        },
        "destructive": {
          "root": {
            "background": "--color-status-error"
          },
          "label": {
            "color": "--color-text-on-brand"
          }
        }
      }
    },
    "size": {
      "prop": "size",
      "cases": {
        "lg": {
          "root": {
            "size": {
              "height": 56
            },
            "padding": {
              "x": 24
            }
          },
          "label": {
            "style": "--text-body"
          }
        },
        "sm": {
          "root": {
            "size": {
              "height": 40
            },
            "padding": {
              "x": 16
            }
          },
          "label": {
            "style": "--text-body-sm"
          }
        },
        "xs": {
          "root": {
            "size": {
              "height": 32
            },
            "padding": {
              "x": 12
            },
            "radius": "--radius-sm"
          },
          "label": {
            "style": "--text-body-xs"
          }
        }
      }
    },
    "fullWidth": {
      "prop": "fullWidth",
      "cases": {
        "true": {
          "root": {
            "size": {
              "width": "fill"
            }
          }
        }
      }
    },
    "loading": {
      "prop": "loading",
      "cases": {
        "true": {
          "iconLeft": {
            "visible": false
          },
          "iconRight": {
            "visible": false
          },
          "spinner": {
            "visible": true
          }
        }
      }
    },
    "interaction": {
      "prop": "interaction",
      "cases": {
        "pressed": {
          "root": {
            "background": "--button-primary-bg-active"
          }
        },
        "disabled": {
          "root": {
            "opacity": "--state-disabled-opacity"
          }
        }
      }
    }
  },
  "uses": [],
  "notes": "Root background/radius live on the row itself (row is treated as the surface here since the whole component is one filled control): default primary background is --button-primary-bg, radius --radius-md (--radius-sm at size xs). A loading spinner (18px ring, border-based) replaces both icons; it is generated artwork the schema cannot express as a node type. iconLeft/iconRight are hidden (and their gap collapses) when the respective prop is not set."
}