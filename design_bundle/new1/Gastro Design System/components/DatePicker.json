{
  "kind": "component",
  "name": "DatePicker",
  "version": "2026-09-12",
  "description": "Compact horizontal day-scroller for near-term date selection (reservations, scheduled orders) — not a full calendar.",
  "size": {
    "width": "fill",
    "height": "hug"
  },
  "surface": null,
  "tree": {
    "slot": "root",
    "type": "column",
    "spacing": [
      "--space-sm"
    ],
    "padding": null,
    "align": "stretch",
    "justify": "start",
    "scroll": "none",
    "size": {
      "width": "fill"
    },
    "children": [
      {
        "slot": "label",
        "type": "text",
        "content": "{label}",
        "style": "--text-body",
        "color": "--input-label",
        "lines": 1,
        "overflow": "clip",
        "align": "start",
        "transform": "none",
        "size": {
          "width": "fill"
        }
      },
      {
        "slot": "days",
        "type": "row",
        "spacing": [
          8
        ],
        "padding": {
          "bottom": 4
        },
        "align": "center",
        "justify": "start",
        "scroll": "horizontal",
        "size": {
          "width": "fill"
        },
        "children": [
          {
            "slot": "day",
            "type": "box",
            "size": [
              52,
              64
            ],
            "background": "--color-bg-main",
            "radius": "--radius-md",
            "border": {
              "width": 1,
              "color": "--color-border-default"
            },
            "padding": null,
            "child": {
              "slot": "day.col",
              "type": "column",
              "spacing": [
                2
              ],
              "padding": null,
              "align": "center",
              "justify": "center",
              "scroll": "none",
              "size": {
                "width": "fill"
              },
              "children": [
                {
                  "slot": "day.weekday",
                  "type": "text",
                  "content": "{weekday}",
                  "style": "--text-caption",
                  "color": "--color-text-primary",
                  "lines": 1,
                  "overflow": "clip",
                  "align": "center",
                  "transform": "uppercase",
                  "size": {
                    "width": "hug"
                  }
                },
                {
                  "slot": "day.date",
                  "type": "text",
                  "content": "{date}",
                  "style": "--text-body-lg",
                  "color": "--color-text-primary",
                  "lines": 1,
                  "overflow": "clip",
                  "align": "center",
                  "transform": "none",
                  "size": {
                    "width": "hug"
                  }
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "variants": {
    "active": {
      "prop": "day.state",
      "cases": {
        "active": {
          "day": {
            "background": "--color-brand-primary",
            "border": null
          },
          "day.weekday": {
            "color": "--color-text-on-brand"
          },
          "day.date": {
            "color": "--color-text-on-brand"
          }
        }
      }
    },
    "label": {
      "prop": "label",
      "cases": {
        "null": {
          "label": {
            "visible": false
          }
        }
      }
    }
  },
  "uses": [],
  "notes": "day.weekday font-size is 11px in source, off scale, approximated to --text-caption; weight semibold, opacity 0.8 (dropped, color token already sets contrast)."
}