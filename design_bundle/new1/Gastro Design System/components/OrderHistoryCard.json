{
  "kind": "component",
  "name": "OrderHistoryCard",
  "version": "2026-09-12",
  "description": "Past-order summary card: restaurant, date, item preview, total, status pill, and a trailing action slot (e.g. ReorderButton).",
  "size": {
    "width": "fill",
    "height": "hug"
  },
  "surface": {
    "background": "--card-bg",
    "radius": "--radius-card",
    "border": {
      "width": 1,
      "color": "--card-border"
    },
    "padding": {
      "all": "--space-base"
    }
  },
  "tree": {
    "slot": "root",
    "type": "column",
    "spacing": [
      "--space-sm",
      "--space-md"
    ],
    "padding": null,
    "align": "stretch",
    "justify": "start",
    "scroll": "none",
    "size": {
      "width": "fill"
    },
    "children": [
      {
        "slot": "header",
        "type": "row",
        "spacing": [
          8
        ],
        "padding": null,
        "align": "start",
        "justify": "between",
        "scroll": "none",
        "size": {
          "width": "fill"
        },
        "children": [
          {
            "slot": "info",
            "type": "column",
            "spacing": [
              0
            ],
            "padding": null,
            "align": "start",
            "justify": "start",
            "scroll": "none",
            "size": {
              "width": "fill"
            },
            "children": [
              {
                "slot": "restaurantName",
                "type": "text",
                "content": "{restaurantName}",
                "style": "--text-h3",
                "color": "--color-text-primary",
                "lines": 1,
                "overflow": "clip",
                "align": "start",
                "transform": "none",
                "size": {
                  "width": "fill"
                }
              },
              {
                "slot": "date",
                "type": "text",
                "content": "{date}",
                "style": "--text-caption",
                "color": "--color-text-tertiary",
                "lines": 1,
                "overflow": "clip",
                "align": "start",
                "transform": "none",
                "size": {
                  "width": "fill"
                }
              }
            ]
          },
          {
            "slot": "status",
            "type": "component",
            "component": "StatusPill",
            "shows": {
              "children": "{status}",
              "tone": "success"
            }
          }
        ]
      },
      {
        "slot": "itemsSummary",
        "type": "text",
        "content": "{itemsSummary}",
        "style": "--text-body",
        "color": "--color-text-secondary",
        "lines": 0,
        "overflow": "wrap",
        "align": "start",
        "transform": "none",
        "size": {
          "width": "fill"
        }
      },
      {
        "slot": "footer",
        "type": "row",
        "spacing": [],
        "padding": null,
        "align": "center",
        "justify": "between",
        "scroll": "none",
        "size": {
          "width": "fill"
        },
        "children": [
          {
            "slot": "total",
            "type": "text",
            "content": "${total}",
            "style": "--text-body-lg",
            "color": "--color-text-primary",
            "lines": 1,
            "overflow": "clip",
            "align": "start",
            "transform": "none",
            "size": {
              "width": "hug"
            }
          },
          {
            "slot": "actions",
            "type": "box",
            "size": [
              "hug",
              "hug"
            ],
            "background": null,
            "radius": null,
            "border": null,
            "padding": null,
            "child": null
          }
        ]
      }
    ]
  },
  "variants": {
    "actions": {
      "prop": "actions",
      "cases": {
        "null": {
          "actions": {
            "visible": false
          }
        }
      }
    }
  },
  "uses": [
    "StatusPill"
  ],
  "notes": "total weight is bold over --text-body-lg. StatusPill's own tone/status text follow the status string as passed through (source hardcodes the success tonal look regardless of status value)."
}