{
  "kind": "component",
  "name": "MembershipTierPill",
  "version": "2026-09-12",
  "description": "Pill showing a loyalty membership tier with a crown icon and an optional discount amount, for dark loyalty surfaces.",
  "size": {
    "width": "hug",
    "height": "hug"
  },
  "surface": null,
  "tree": {
    "slot": "root",
    "type": "row",
    "spacing": [
      6
    ],
    "padding": {
      "x": 12,
      "y": 4
    },
    "align": "center",
    "justify": "start",
    "scroll": "none",
    "size": {
      "width": "hug"
    },
    "children": [
      {
        "slot": "crown",
        "type": "icon",
        "name": "crown",
        "weight": "fill",
        "size": 13,
        "color": "--gray-0"
      },
      {
        "slot": "label",
        "type": "text",
        "content": "{membership}",
        "style": "--text-body-xs",
        "color": "--gray-0",
        "lines": 1,
        "overflow": "clip",
        "align": "start",
        "transform": "none",
        "size": {
          "width": "hug"
        }
      },
      {
        "slot": "discount",
        "type": "text",
        "content": "· {discountLabel} off",
        "style": "--text-body-xs",
        "color": "--gray-0",
        "lines": 1,
        "overflow": "clip",
        "align": "start",
        "transform": "none",
        "size": {
          "width": "hug"
        }
      }
    ]
  },
  "variants": {
    "discountLabel": {
      "prop": "discountLabel",
      "cases": {
        "null": {
          "discount": {
            "visible": false
          }
        }
      }
    }
  },
  "uses": [],
  "notes": "root background is white at 10% opacity (rgba(255,255,255,0.10)) — no matching --alpha-white-* token exists at exactly 10% (closest is --alpha-white-8 or --alpha-white-12); kept as the literal source value rather than approximated, since it's below the flagged token-mapping threshold for a color field. crown icon size 13px is off the --icon-* scale, kept as a raw number."
}